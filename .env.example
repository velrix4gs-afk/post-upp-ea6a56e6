# Public client config (safe to commit)
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_STREAM_API_KEY="<stream-public-key>"

# Optional: override the default Supabase Functions URL used by apiGateway.
# Leave unset to derive automatically from VITE_SUPABASE_URL.
VITE_API_GATEWAY_URL=""

# --- DO NOT put server secrets here ---
# REDIS_URL and REDIS_TOKEN must be configured ONLY as Supabase edge
# function secrets (Project Settings -> Edge Functions -> Secrets).
# Never commit Redis host/port/password to this repo.
